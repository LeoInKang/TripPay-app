{
  "expo": {
    "name": "TripPay",
    "slug": "TripPay",
    "version": "1.2.6",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4271B1"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.leoinkang.trippay",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4271B1"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.leoinkang.trippay",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "3d6bc013-393a-4523-a6da-b69c1013e499"
      }
    }
  }
}
